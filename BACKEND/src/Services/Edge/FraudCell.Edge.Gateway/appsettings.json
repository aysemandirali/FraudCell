{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "fraudcell-identity",
    "Audience": "fraudcell-api",
    "PublicKeyPath": "/keys/identity/public.pem"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "identity-staff-root": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/staff" }
      },
      "identity-staff": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/staff/{**catch-all}" }
      },
      "identity-reference": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/reference/{**catch-all}" }
      },
      "identity-audit-root": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/audit-logs" }
      },
      "identity-audit": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/audit-logs/{**catch-all}" }
      },
      "transaction-root": {
        "ClusterId": "transaction",
        "Match": { "Path": "/api/v1/transactions" }
      },
      "transaction": {
        "ClusterId": "transaction",
        "Match": { "Path": "/api/v1/transactions/{**catch-all}" }
      },
      "case-root": {
        "ClusterId": "transaction",
        "Match": { "Path": "/api/v1/cases" }
      },
      "case": {
        "ClusterId": "transaction",
        "Match": { "Path": "/api/v1/cases/{**catch-all}" }
      },
      "customer-verifications": {
        "ClusterId": "transaction",
        "Match": { "Path": "/api/v1/customer/verifications/{**catch-all}" }
      },
      "gamification": {
        "ClusterId": "gamification",
        "Match": { "Path": "/api/v1/game/{**catch-all}" }
      },
      "ai": {
        "ClusterId": "ai",
        "Match": { "Path": "/api/v1/ai/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-service": { "Address": "http://identity-service:8080/" }
        }
      },
      "transaction": {
        "Destinations": {
          "transaction-service": { "Address": "http://transaction-service:8080/" }
        }
      },
      "gamification": {
        "Destinations": {
          "gamification-service": { "Address": "http://gamification-service:8080/" }
        }
      },
      "ai": {
        "Destinations": {
          "ai-service": { "Address": "http://ai-service:8000/" }
        }
      }
    }
  }
}

