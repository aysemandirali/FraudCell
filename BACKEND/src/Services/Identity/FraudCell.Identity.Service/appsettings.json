{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "Host=identity-db;Port=5432;Database=fraudcell_identity;Username=identity_app;Password=CHANGE_ME"
  },
  "Jwt": {
    "Issuer": "fraudcell-identity",
    "Audience": "fraudcell-api",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "PrivateKeyPath": "/keys/identity/private.pem",
    "PublicKeyPath": "/keys/identity/public.pem"
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "UseFixedDemoCode": false,
    "FixedDemoCode": "1234"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "UserName": "fraudcell",
    "Password": "CHANGE_ME",
    "VirtualHost": "/"
  },
  "Outbox": {
    "PollIntervalMilliseconds": 500,
    "BatchSize": 50
  }
}
