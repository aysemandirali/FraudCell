# FraudCell local Docker Compose ortam degiskenleri.
# Gercek degerlerle doldurup `.env` olarak kaydedin (`.env` .gitignore'da, repoya girmez — SEC-011).
#
#   cp .env.example .env

# --- Genel ---
# Development: RsaKeyProvider anahtar bulunamazsa gecici cift uretip diske yazar.
# Production/demo icin onceden uretilmis anahtar zorunludur (bkz. Security/RsaKeyProvider.cs).
ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL sifreleri (her servis icin ayri) ---
IDENTITY_DB_PASSWORD=change_me_identity
TRANSACTION_DB_PASSWORD=change_me_transaction
GAMIFICATION_DB_PASSWORD=change_me_gamification

# --- RabbitMQ ---
RABBITMQ_USER=fraudcell
RABBITMQ_PASSWORD=change_me_rabbitmq
