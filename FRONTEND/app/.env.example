# API modu:
#   mock -> MSW ile tarayıcı içi sahte backend (backend henüz ayakta değilken)
#   live -> istekler /api/v1 üzerinden Edge Gateway'e gider
VITE_API_MODE=mock

# Edge Gateway adresi (yalnızca dev proxy için kullanılır)
VITE_GATEWAY_URL=http://localhost:8080

# API taban yolu
VITE_API_BASE_URL=/api/v1
