# API modu:
#   mock -> MSW ile tarayıcı içi sahte backend (backend ayakta değilken)
#   live -> istekler Gateway'e gider
#
# Not: backend'de yalnızca Identity ve Transaction servisleri yazıldı.
# Gamification, bildirim, AI metrikleri ve dashboard aggregate'leri yalnızca
# mock modda veri döndürür.
VITE_API_MODE=mock

# Gateway adresi — SADECE dev proxy'si için kullanılır (vite.config.ts).
# Production'da frontend Gateway ile aynı origin'de yayınlandığı için gerekmez.
VITE_GATEWAY_URL=http://localhost:8080

# API taban URL'i.
#
# BOŞ BIRAKIN. DESIGN.MD'nin production topolojisi tek origin üzerine kurulu:
# istekler `/api/v1/...` şeklinde göreli gider, CORS'a hiç girilmez.
# `/api/v1` öneki client tarafında (shared/config/env.ts) zaten ekleniyor —
# buraya da yazılırsa yol `/api/v1/api/v1/...` olur.
VITE_API_BASE_URL=
